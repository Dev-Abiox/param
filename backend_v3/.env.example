# ============================================================
# Clinomic B12 Screening Platform — Required Environment Variables
# Copy this file to .env and fill in real values before starting.
# NEVER commit .env to version control.
# ============================================================

# ── Django core ─────────────────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-at-least-50-random-chars

# 'dev' | 'testing' | 'production'
APP_ENV=dev
DEBUG=False

ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:3000

# ── Database ─────────────────────────────────────────────────
POSTGRES_DB=clinomic
POSTGRES_USER=clinomic_user
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
# DB connection pool lifetime in seconds (Django ↔ PgBouncer leg)
CONN_MAX_AGE=60

# ── JWT ──────────────────────────────────────────────────────
# All three must be distinct from each other and from DJANGO_SECRET_KEY
JWT_SECRET_KEY=replace-with-separate-jwt-secret-at-least-50-chars
JWT_REFRESH_SECRET_KEY=replace-with-separate-refresh-secret-at-least-50-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── PHI Encryption (Fernet key) ──────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_ENCRYPTION_KEY=replace-with-fernet-key

# ── Audit chain HMAC signing ─────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AUDIT_SIGNING_KEY=replace-with-64-char-hex-string

# ── MFA ───────────────────────────────────────────────────────
MFA_REQUIRED_ROLES=ADMIN,DOCTOR

# ── Email (for password reset) ────────────────────────────────
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@clinomiclabs.com
EMAIL_HOST_PASSWORD=replace-with-email-password
DEFAULT_FROM_EMAIL=Clinomic <noreply@clinomiclabs.com>

# Frontend URL (for links in emails)
FRONTEND_URL=http://localhost:3000

# ── Redis ─────────────────────────────────────────────────────
# C5: Redis requires a password in production. Generate with:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
REDIS_PASSWORD=replace-with-strong-redis-password

# Celery broker/result uses /0, Django cache uses /1, Channels (WebSocket) uses /2
# Include the password in all Redis URLs: redis://:PASSWORD@host:port/db
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
CACHE_REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/1
CHANNELS_REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/2

# ── Domain ────────────────────────────────────────────────────
BASE_DOMAIN=clinomiclabs.com

# ── Billing (Razorpay) ────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret

# ── CSRF ──────────────────────────────────────────────────────
CSRF_TRUSTED_ORIGINS=https://clinomiclabs.com

# ── Sentry (optional – leave blank to disable) ────────────────
SENTRY_DSN=

# ── S3 Database Backups (optional – leave blank to disable) ───
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=db-backups/
AWS_BACKUP_ACCESS_KEY_ID=
AWS_BACKUP_SECRET_ACCESS_KEY=

# ── Monitoring (Prometheus + Grafana) ─────────────────────────
GRAFANA_ADMIN_PASSWORD=replace-with-strong-grafana-password
